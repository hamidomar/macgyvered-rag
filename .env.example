OPENAI_API_KEY=sk-...
OPENAI_MODEL_EXTRACTION=gpt-4.1
OPENAI_MODEL_LOA=gpt-4.1
OPENAI_MODEL_VERIFIER=gpt-4.1
PLAYGROUND_HOST=0.0.0.0
PLAYGROUND_PORT=7777
AGNO_HISTORY_LENGTH=12

# Point this to the generated deterministic FNMA guide index directory.
FNMA_INDEX_DIR=/absolute/path/to/macgyvered-rag/retrival/output/selling_guide_preprocessed

# Point this to the generated deterministic Freddie Mac Single-Family guide index directory.
FHLMC_INDEX_DIR=/absolute/path/to/macgyvered-rag/retrival/output/sf_guide_index

AGNO_STORAGE_DB=runtime/agents.db
